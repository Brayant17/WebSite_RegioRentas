---
import Layout from "../../layouts/Layout.astro";

const MOCK = [
    { edificio: "FRAMBOYAN", propietario: "Cuarto 1" },
    { edificio: "FRAMBOYAN", propietario: "Cuarto 2" },
    { edificio: "FRAMBOYAN", propietario: "Cuarto 3" },
    { edificio: "FRAMBOYAN", propietario: "Cuarto 4" },
    { edificio: "FRAMBOYAN", propietario: "Cuarto 5" },
    { edificio: "FRAMBOYAN", propietario: "Cuarto 6" },
    { edificio: "ONCEAVA", propietario: "Depa D" },
    { edificio: "ONCEAVA", propietario: "Depa C" },
    { edificio: "ONCEAVA", propietario: "Depa B" },
    { edificio: "ONCEAVA", propietario: "Depa A" },
    { edificio: "ONCEAVA", propietario: "Depa E" },
];

// Agrupamos por edificio para evitar repetir la etiqueta en cada tarjeta
const edificios = MOCK.reduce(
    (acc, item) => {
        if (!acc[item.edificio]) acc[item.edificio] = [];
        acc[item.edificio].push(item);
        return acc;
    },
    {} as Record<string, typeof MOCK>,
);
---

<Layout title="Solicitud de arrendamiento">
    <section class="mx-auto max-w-6xl px-6 py-10">
        <div class="mb-10">
            <h1 class="text-3xl font-bold tracking-tight">
                Solicitud de arrendamiento
            </h1>
            <p class="mt-2 text-muted-foreground">
                Selecciona la habitación o departamento para iniciar tu
                solicitud.
            </p>
        </div>

        {
            Object.entries(edificios).map(([edificio, unidades]) => (
                <div class="mb-12 last:mb-0">
                    <div class="mb-4 flex items-baseline gap-3 border-b pb-2">
                        <h2 class="text-lg font-semibold tracking-tight">
                            {edificio}
                        </h2>
                        <span class="text-sm text-muted-foreground">
                            {unidades.length}{" "}
                            {unidades.length === 1 ? "unidad" : "unidades"}{" "}
                            disponibles
                        </span>
                    </div>

                    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                        {unidades.map((item) => (
                            <div class="group flex flex-col justify-between rounded-xl border bg-card p-6 shadow-sm transition-all hover:-translate-y-1 hover:shadow-lg">
                                <div class="mb-5">
                                    <span class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                                        Unidad
                                    </span>
                                    <h3 class="mt-1 text-xl font-semibold">
                                        {item.propietario}
                                    </h3>
                                </div>

                                <a
                                    href={`/arrendamiento/solicitud?edificio=${encodeURIComponent(
                                        item.edificio,
                                    )}&unidad=${encodeURIComponent(
                                        item.propietario,
                                    )}`}
                                    aria-label={`Solicitar arrendamiento de ${item.propietario} en ${item.edificio}`}
                                    class="inline-flex w-full items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                                >
                                    Solicitar arrendamiento
                                </a>
                            </div>
                        ))}
                    </div>
                </div>
            ))
        }
    </section>
</Layout>
