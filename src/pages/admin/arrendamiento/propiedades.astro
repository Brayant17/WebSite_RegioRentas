---
// Dashboard.astro
import AdminLayout from "@/layouts/AdminLayout.astro";
import { supabaseServer } from "@/lib/supabaseServer";
import PropiedadesArrendamiento from "@/modules/admin/arrendamiento/propiedades/PropiedadesArrendamiento";
import type { Edificio } from "@/modules/admin/arrendamiento/types/edificios.type";

// Obtener los edificios desde el server
const supabase = supabaseServer(Astro.cookies);
const { data } = await supabase.from("edificios_con_totales").select("*");

const edificios = data as Edificio[] ?? [];
---

<AdminLayout title="Dashboard">
    <main class="space-y-4">
        <PropiedadesArrendamiento initialEdificios={edificios} client:load />
    </main>
</AdminLayout>
